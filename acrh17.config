# 华硕 RT-ACRH17（lede 里和 RT-AC42U 共用 asus_rt-ac42u 定义）
CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_ipq40xx_generic_DEVICE_asus_rt-ac42u=y

# L2TP/IPsec VPN 客户端（IKEv1 + PSK）
# strongswan 基础包必须显式启用；isakmp 带入 IKE/IPsec 及主要加密依赖。
CONFIG_PACKAGE_strongswan=y
CONFIG_PACKAGE_strongswan-isakmp=y
CONFIG_PACKAGE_strongswan-mod-sha2=y
CONFIG_PACKAGE_xl2tpd=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppol2tp=y
CONFIG_PACKAGE_luci-proto-ppp=y

# LuCI 提供 L2TP 接口配置；IPsec PSK 需在刷机后另外配置。
