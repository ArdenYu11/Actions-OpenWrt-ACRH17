#!/bin/sh
# 检查并补齐本插件依赖的防火墙配置。首次安装、开机和每次连接前都会调用，
# 用旧备份恢复配置后也能自动补回。只补缺失的部分，不覆盖已有区域的策略选项；
# 有实际改动才写回并重新加载。
#
# 其他操作用 uci set 暂存、还没决定应用的改动在 /tmp/.uci 里，本插件既不能提交它们，也不能让它们提前生效：
# - uci commit 会把同名配置的全部暂存改动一起提交，换用 -t 指定的暂存目录也一样
#   （/tmp/.uci 始终在 uci 的读取路径里）。所以改动在副本上做：副本换成 lp_ 开头的包名，
#   读不到也提交不了别人的暂存改动。
# - firewall4、netifd 重新加载时用默认方式读配置，同样会叠加 /tmp/.uci 里的改动。所以某个配置
#   有别人的暂存改动时，本次不写回也不重载它，提交或放弃这些改动后下次连接再补。
# 写回时与 uci commit 一样对配置文件加排他锁，核对和替换之间别人提交不进来。

umask 077
LP_IFACE=l2tp-vpn
# 以下路径可由测试覆盖
LP_INITD=${LP_INITD:-/etc/init.d}
LP_SYSNET=${LP_SYSNET:-/sys/class/net}
LP_UCI_FILE=${LP_UCI_FILE:-/etc/config/l2tpipsec}
LP_CONFDIR=${LP_CONFDIR:-/etc/config}
LP_CONF2DIR=${LP_CONF2DIR:-/var/run/uci}
[ ! -f "$LP_UCI_FILE" ] || chmod 600 "$LP_UCI_FILE"

work=$(mktemp -d "${TMPDIR:-/tmp}/l2tpipsec-config.XXXXXX") || exit 1
trap 'rm -rf "$work"' EXIT
mkdir "$work/save" || exit 1

# uci 优先使用 /var/run/uci 下的同名配置
config_path() {
	if [ -f "$LP_CONF2DIR/$1" ]; then
		printf '%s\n' "$LP_CONF2DIR/$1"
	else
		printf '%s\n' "$LP_CONFDIR/$1"
	fi
}

for name in network firewall; do
	cp "$(config_path "$name")" "$work/$name.orig" || exit 1
	cp "$work/$name.orig" "$work/lp_$name" || exit 1
done

# 只操作副本，暂存也写在临时目录里
cfg() {
	uci -q -c "$work" -t "$work/save" "$@"
}

# 值不同才写，避免产生无意义的改动
set_option() {
	[ "$(cfg get "lp_$1")" = "$2" ] || cfg set "lp_$1=$2"
}

inode() {
	ls -di "$1" 2>/dev/null | awk '{print $1}'
}

# 把副本写回原文件，成功返回 0；原文件期间被别人改过或写回失败返回 1。
# uci commit 打开配置文件后加 flock 排他锁，再从这个文件重新读取、改名替换，这里用同一把锁。
# 打开前先记下 inode：拿到锁时文件已被别人改名替换的话，锁住的是旧文件，挡不住后来的提交，放弃。
publish() {
	local target new before
	target=$(config_path "$1")
	new="${target%/*}/.$1.l2tpipsec-new"
	before=$(inode "$target")
	[ -n "$before" ] || return 1
	(
		# OpenWrt 的 busybox 默认带 flock；万一裁掉了，退回不加锁
		if command -v flock >/dev/null; then flock -x 9 || exit 1; fi
		[ "$(inode "$target")" = "$before" ] && cmp -s "$work/$1.orig" "$target" || exit 1
		# 复制原文件保留权限，再换内容，最后改名替换
		cp -p "$target" "$new" && cat "$work/lp_$1" > "$new" && mv "$new" "$target" && exit 0
		rm -f "$new"
		exit 1
	) 9< "$target"
}

# 旧版本为 l2tp-vpn 建了 netifd 接口。netifd 接管 pppd 建出的网卡时会清空它的地址和路由，
# 所以改为直接在防火墙区域里写网卡名，这里移除旧接口。连接中不动，避免当场把 VPN 清空。
if [ "$(cfg get lp_network.l2tpipsec.proto)" = none ] &&
	[ "$(cfg get lp_network.l2tpipsec.device)" = "$LP_IFACE" ] &&
	[ ! -d "$LP_SYSNET/$LP_IFACE" ]; then
	cfg delete lp_network.l2tpipsec
fi

if [ "$(cfg get lp_firewall.l2tpipsec)" != zone ]; then
	cfg set lp_firewall.l2tpipsec=zone
	cfg set lp_firewall.l2tpipsec.name=l2tpipsec
	cfg set lp_firewall.l2tpipsec.input=REJECT
	cfg set lp_firewall.l2tpipsec.output=ACCEPT
	cfg set lp_firewall.l2tpipsec.forward=REJECT
	cfg set lp_firewall.l2tpipsec.masq=1
	cfg set lp_firewall.l2tpipsec.mtu_fix=1
fi
case " $(cfg get lp_firewall.l2tpipsec.device) " in
	*" $LP_IFACE "*) ;;
	*) cfg add_list lp_firewall.l2tpipsec.device="$LP_IFACE" ;;
esac
case " $(cfg get lp_firewall.l2tpipsec.network) " in
	*" l2tpipsec "*) cfg del_list lp_firewall.l2tpipsec.network=l2tpipsec ;;
esac

if [ "$(cfg get lp_firewall.l2tpipsec_lan)" != forwarding ]; then
	cfg set lp_firewall.l2tpipsec_lan=forwarding
	cfg set lp_firewall.l2tpipsec_lan.src=lan
	cfg set lp_firewall.l2tpipsec_lan.dest=l2tpipsec
fi

# 仅接受此实例已解密的 L2TP，保护外层 IPsec 不被 WAN NAT 改写。
set_option firewall.l2tpipsec_input include
set_option firewall.l2tpipsec_input.type nftables
set_option firewall.l2tpipsec_input.path /usr/share/l2tp-ipsec-client/input.nft
set_option firewall.l2tpipsec_input.position chain-prepend
set_option firewall.l2tpipsec_input.chain input
set_option firewall.l2tpipsec_snat include
set_option firewall.l2tpipsec_snat.type nftables
set_option firewall.l2tpipsec_snat.path /usr/share/l2tp-ipsec-client/snat.nft
set_option firewall.l2tpipsec_snat.position chain-prepend
set_option firewall.l2tpipsec_snat.chain srcnat

# DNS 模块只向 LAN 和路由器本机提供服务。
if [ "$(cfg get lp_firewall.l2tpipsec_dns)" != rule ]; then
	cfg set lp_firewall.l2tpipsec_dns=rule
	cfg set lp_firewall.l2tpipsec_dns.name='Allow-L2TP-IPsec-DNS'
	cfg set lp_firewall.l2tpipsec_dns.src=lan
	cfg set lp_firewall.l2tpipsec_dns.proto='tcp udp'
	cfg set lp_firewall.l2tpipsec_dns.dest_port=1053
	cfg set lp_firewall.l2tpipsec_dns.family=any
	cfg set lp_firewall.l2tpipsec_dns.target=ACCEPT
fi

# 失败原因写到标准输出，由工作进程记进连接日志；重新加载的输出改走标准错误。
result=0
network_changed=0
firewall_changed=0
for name in network firewall; do
	cfg commit "lp_$name" || { echo "无法生成 $name 配置。"; result=1; continue; }
	cmp -s "$work/lp_$name" "$work/$name.orig" && continue
	if [ -n "$(uci -q changes "$name")" ]; then
		case "$name" in
		network) echo '网络配置有尚未提交的其他改动（uci changes network），为免重新加载时让它们提前生效，本次未移除旧版留下的 network.l2tpipsec 接口。' ;;
		firewall) echo '防火墙配置有尚未提交的其他改动（uci changes firewall），为免重新加载时让它们提前生效，本次未补齐 VPN 所需的防火墙配置，局域网设备可能无法经 VPN 访问。请先提交或放弃这些改动，再重新连接。' ;;
		esac
		result=1
		continue
	fi
	if ! publish "$name"; then
		echo "$name 配置在检查期间被其他操作修改，本次未写回，下次连接时再补齐。"
		result=1
		continue
	fi
	case "$name" in
	network) network_changed=1 ;;
	firewall) firewall_changed=1 ;;
	esac
done

if [ "$1" != --no-reload ]; then
	[ "$network_changed" = 0 ] || "$LP_INITD/network" reload >&2
	[ "$firewall_changed" = 0 ] || "$LP_INITD/firewall" reload >&2
fi
exit "$result"
