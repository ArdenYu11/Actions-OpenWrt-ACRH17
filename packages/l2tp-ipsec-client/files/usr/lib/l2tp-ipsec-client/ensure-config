#!/bin/sh
# 检查并补齐本插件依赖的防火墙配置。首次安装、开机和每次连接前都会调用，
# 用旧备份恢复配置后也能自动补回。只补缺失的部分，不覆盖已有区域的策略选项；
# 有实际改动才重新加载防火墙。

umask 077
LP_IFACE=l2tp-vpn
# 以下路径可由测试覆盖
LP_INITD=${LP_INITD:-/etc/init.d}
LP_SYSNET=${LP_SYSNET:-/sys/class/net}
LP_UCI_FILE=${LP_UCI_FILE:-/etc/config/l2tpipsec}
[ ! -f "$LP_UCI_FILE" ] || chmod 600 "$LP_UCI_FILE"

# 值不同才写，避免产生无意义的改动
set_option() {
	[ "$(uci -q get "$1")" = "$2" ] || uci set "$1=$2"
}

network_changed=0
# 旧版本为 l2tp-vpn 建了 netifd 接口。netifd 接管 pppd 建出的网卡时会清空它的地址和路由，
# 所以改为直接在防火墙区域里写网卡名，这里移除旧接口。连接中不动，避免当场把 VPN 清空。
if [ "$(uci -q get network.l2tpipsec.proto)" = none ] &&
	[ "$(uci -q get network.l2tpipsec.device)" = "$LP_IFACE" ] &&
	[ ! -d "$LP_SYSNET/$LP_IFACE" ]; then
	uci -q delete network.l2tpipsec
	uci commit network
	network_changed=1
fi

if [ "$(uci -q get firewall.l2tpipsec)" != zone ]; then
	uci set firewall.l2tpipsec=zone
	uci set firewall.l2tpipsec.name=l2tpipsec
	uci set firewall.l2tpipsec.input=REJECT
	uci set firewall.l2tpipsec.output=ACCEPT
	uci set firewall.l2tpipsec.forward=REJECT
	uci set firewall.l2tpipsec.masq=1
	uci set firewall.l2tpipsec.mtu_fix=1
fi
case " $(uci -q get firewall.l2tpipsec.device) " in
	*" $LP_IFACE "*) ;;
	*) uci add_list firewall.l2tpipsec.device="$LP_IFACE" ;;
esac
case " $(uci -q get firewall.l2tpipsec.network) " in
	*" l2tpipsec "*) uci del_list firewall.l2tpipsec.network=l2tpipsec ;;
esac

if [ "$(uci -q get firewall.l2tpipsec_lan)" != forwarding ]; then
	uci set firewall.l2tpipsec_lan=forwarding
	uci set firewall.l2tpipsec_lan.src=lan
	uci set firewall.l2tpipsec_lan.dest=l2tpipsec
fi

# 仅接受此实例已解密的 L2TP，保护外层 IPsec 不被 WAN NAT 改写。
set_option firewall.l2tpipsec_input include
set_option firewall.l2tpipsec_input.type nftables
set_option firewall.l2tpipsec_input.path /usr/share/l2tp-ipsec-client/input.nft
set_option firewall.l2tpipsec_input.position chain-prepend
set_option firewall.l2tpipsec_input.chain input
set_option firewall.l2tpipsec_snat include
set_option firewall.l2tpipsec_snat.type nftables
set_option firewall.l2tpipsec_snat.path /usr/share/l2tp-ipsec-client/snat.nft
set_option firewall.l2tpipsec_snat.position chain-prepend
set_option firewall.l2tpipsec_snat.chain srcnat

# DNS 模块只向 LAN 和路由器本机提供服务。
if [ "$(uci -q get firewall.l2tpipsec_dns)" != rule ]; then
	uci set firewall.l2tpipsec_dns=rule
	uci set firewall.l2tpipsec_dns.name='Allow-L2TP-IPsec-DNS'
	uci set firewall.l2tpipsec_dns.src=lan
	uci set firewall.l2tpipsec_dns.proto='tcp udp'
	uci set firewall.l2tpipsec_dns.dest_port=1053
	uci set firewall.l2tpipsec_dns.family=any
	uci set firewall.l2tpipsec_dns.target=ACCEPT
fi

firewall_changed=0
if [ -n "$(uci -q changes firewall)" ]; then
	uci commit firewall
	firewall_changed=1
fi

[ "$1" = --no-reload ] && exit 0
[ "$network_changed" = 0 ] || "$LP_INITD/network" reload
[ "$firewall_changed" = 0 ] || "$LP_INITD/firewall" reload
exit 0
