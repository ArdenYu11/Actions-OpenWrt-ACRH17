#!/bin/sh

umask 077
. /usr/lib/l2tp-ipsec-client/common.sh

down() {
 "$LP_LIB/routing" down
 rm -f "$LP_DIR/ppp.up"
}

if [ "$1" = down ]; then down; exit 0; fi
[ "${PPP_IFACE:-$2}" = l2tp-vpn ] || exit 0
[ -d /sys/class/net/l2tp-vpn ] || { down; exit 0; }
ip -4 address show dev l2tp-vpn | grep -q 'inet ' || { down; exit 0; }
printf '%s\n' "${PPPD_PID:-$PPID}" > "$LP_DIR/ppp.pid"
rm -f "$LP_DIR/route.error"
if ! "$LP_LIB/routing" up; then
 [ -s "$LP_DIR/route.error" ] || printf '%s\n' '路由或 DNS 设置失败，请检查表 41717、规则优先级及 DNS 端口。' > "$LP_DIR/route.error"
 "$LP_LIB/routing" down
fi
: > "$LP_DIR/ppp.up"
