#!/bin/sh

umask 077
chmod 600 /etc/config/l2tpipsec

# 无远端配置的默认服务不应抢占管理实例的端口。
# 已配置的服务保留，连接时由管理实例提示冲突。
if ! uci -q show ipsec | grep -q '=remote' &&
	! grep -Eq '^[[:space:]]*[^#[:space:]]' /etc/swanctl/conf.d/*.conf 2>/dev/null &&
	! grep -Eq '^[[:space:]]*(connections|pools|secrets|authorities)[[:space:]]*\{' /etc/swanctl/swanctl.conf; then
	/etc/init.d/swanctl disable
	[ -n "$IPKG_INSTROOT" ] || /etc/init.d/swanctl stop
fi
if ! grep -Eq '^[[:space:]]*\[(lac|lns)[[:space:]]' /etc/xl2tpd/xl2tpd.conf; then
	/etc/init.d/xl2tpd disable
	[ -n "$IPKG_INSTROOT" ] || /etc/init.d/xl2tpd stop
fi

# 固定接口名供 PPP、netifd 与防火墙共同使用。
if ! uci -q get network.l2tpipsec >/dev/null; then
	uci set network.l2tpipsec=interface
	uci set network.l2tpipsec.proto=none
	uci set network.l2tpipsec.device=l2tp-vpn
	uci set network.l2tpipsec.ifname=l2tp-vpn
	uci set network.l2tpipsec.auto=1
	uci commit network
fi

if ! uci -q get firewall.l2tpipsec >/dev/null; then
	uci set firewall.l2tpipsec=zone
	uci set firewall.l2tpipsec.name=l2tpipsec
	uci add_list firewall.l2tpipsec.network=l2tpipsec
	uci set firewall.l2tpipsec.input=REJECT
	uci set firewall.l2tpipsec.output=ACCEPT
	uci set firewall.l2tpipsec.forward=REJECT
	uci set firewall.l2tpipsec.masq=1
	uci set firewall.l2tpipsec.mtu_fix=1
	uci set firewall.l2tpipsec_lan=forwarding
	uci set firewall.l2tpipsec_lan.src=lan
	uci set firewall.l2tpipsec_lan.dest=l2tpipsec
	uci commit firewall
fi

# 仅接受此实例已解密的 L2TP，保护外层 IPsec 不被 WAN NAT 改写。
uci set firewall.l2tpipsec_input=include
uci set firewall.l2tpipsec_input.type=nftables
uci set firewall.l2tpipsec_input.path=/usr/share/l2tp-ipsec-client/input.nft
uci set firewall.l2tpipsec_input.position=chain-prepend
uci set firewall.l2tpipsec_input.chain=input
uci set firewall.l2tpipsec_snat=include
uci set firewall.l2tpipsec_snat.type=nftables
uci set firewall.l2tpipsec_snat.path=/usr/share/l2tp-ipsec-client/snat.nft
uci set firewall.l2tpipsec_snat.position=chain-prepend
uci set firewall.l2tpipsec_snat.chain=srcnat
uci commit firewall

# 由 UCI 开关决定是否在开机时连接，初始配置默认关闭。
/etc/init.d/l2tp-ipsec-client enable
[ -n "$IPKG_INSTROOT" ] || {
	/etc/init.d/network reload
	/etc/init.d/firewall reload
	/etc/init.d/rpcd restart
}
exit 0
